# Copy to trader/.env for local runs. Alpaca keys are also read from deploy/.env.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Supabase -> Project Settings -> API. The service-role key can write to every
# table: keep it out of git and out of the website.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
